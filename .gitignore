# =========================
# Unity generated folders & files (ported from the existing Plastic ignore.conf)
# =========================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Ll]ogs/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# AssetStoreTools (was ignored under Plastic; keep ignored here too)
**/[Aa]ssets/AssetStoreTools

# Plastic SCM plugin folder that Unity used to drop into Assets/Plugins
/[Aa]ssets/Plugins/PlasticSCM*

# Private assets convention (matches the old Plastic patterns)
*.private
*.private.meta
*.private.[0-9]*
*.private.[0-9]*.meta

# =========================
# Plastic SCM (Unity Version Control) metadata — left on disk untouched,
# but no longer tracked so git is the single source of truth going forward.
# =========================
.plastic/
*.plastic
PlasticWorkspace*.txt

# =========================
# IDE / editor clutter
# =========================
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/

# Visual Studio project files (regenerated by Unity on every open)
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
.vsconfig

# Unity upgrade log (regenerated on engine upgrade — fine to ignore)
UpgradeLog.htm

# =========================
# Build artifacts
# =========================
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
~UnityDirMonSyncFile~*
**/[Aa]ssets/AddressableAssetsData/*/*.bin*
**/[Aa]ssets/StreamingAssets/aa.meta
**/[Aa]ssets/StreamingAssets/aa/*

# =========================
# OS junk
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
