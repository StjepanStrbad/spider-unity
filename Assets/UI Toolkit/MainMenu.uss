/* ============================================================
   SPIDER — Main Menu (UI Toolkit)
   Flex columns so panels never overlap. The middle column
   absorbs all resizing; the side panels keep natural width.
   ============================================================ */

* {
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-VariableFont_wght.ttf");
}

/* ---------- ROOT (3-column flex row) ---------- */

.root {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    color: #DCEEF6;
}

.side-col {
    flex-direction: column;
    flex-shrink: 0;            /* never squeeze the side columns */
    padding-left: 2.5%;
    padding-right: 2.5%;
    padding-top: 3%;
    padding-bottom: 3%;
    justify-content: flex-end;
}
.side-col--right { justify-content: center; }

.mid-col {
    flex-grow: 1;              /* eats all the leftover space */
    min-width: 40px;
}

/* ============================================================
   PANEL CHROME — shared between menu and controls
   ============================================================ */

.edge {
    position: absolute;
    left: -1px;
    top: -1px;
    bottom: -1px;
    width: 3px;
    background-color: #00E5FF;
}

.panel-tag {
    color: #00E5FF;
    font-size: 16px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    opacity: 0.9;
}

/* ============================================================
   RIGHT — MENU PANEL
   ============================================================ */

.panel {
    /* 72% sirine stupca - bez max-widtha, raste i na 4K.
       Paddings u pixelima jer ih PanelSettings (Scale With Screen Size,
       ref. rezolucija 1920x1080, match = height) skalira jednako na
       svakom ekranu - layout uvijek ima 1080 logickih px visine. */
    width: 72%;
    min-width: 500px;
    margin-right:140px;
    padding-left: 56px;
    padding-right: 56px;
    padding-top: 48px;
    padding-bottom: 36px;
    background-color: rgba(8, 14, 24, 0.78);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    border-radius: 2px;
    
    flex-shrink: 0;            /* nikad ne stezi panel - radije siri */
}

.panel-header { flex-direction: column; margin-bottom: 20px; }

.panel-title {
    color: #FFFFFF;
    font-size: 58px;
    letter-spacing: 10px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0.4px;
    -unity-text-outline-color: rgba(0, 229, 255, 0.7);
    text-shadow: 0 0 14px rgba(0, 229, 255, 0.45);
    margin-top: 0;
    margin-bottom: 8px;
    padding: 0;
    /* nowrap maknut - ako je kontejner uzak, naslov se prelama umjesto da klipa */
    flex-shrink: 1;
}

.panel-divider {
    height: 2px;
    width: 30%;
    background-color: #00E5FF;
    margin-top: 8px;
    margin-bottom: 10px;
}

.panel-subtitle {
    color: rgba(103, 255, 233, 0.75);
    font-size: 16px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    white-space: nowrap;
}

/* ---------- BUTTONS ---------- */

.buttons {
    flex-direction: column;
    margin-bottom: 16px;
    width: 100%;               /* uvijek puna sirina parent panela */
}

.mbtn {
    flex-direction: row;
    align-items: center;
    height: 68px;
    margin-top: 5px;
    margin-bottom: 5px;
    padding-left: 20px;
    padding-right: 20px;
    width: 100%;               /* gumb uvijek prati sirinu kontejnera */
    background-color: rgba(8, 14, 24, 0.5);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.18);
    border-radius: 1px;
    transition-property: background-color, border-color, translate;
    transition-duration: 160ms;
    transition-timing-function: ease-out;
}

.mbtn__dot {
    width: 12px;
    height: 12px;
    background-color: rgba(0, 229, 255, 0.35);
    border-radius: 6px;
    margin-right: 20px;
    transition-property: background-color, scale;
    transition-duration: 160ms;
}

.mbtn__label {
    flex-grow: 1;
    color: #C9DEE7;
    font-size: 22px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    transition-property: color, translate;
    transition-duration: 160ms;
}

.mbtn__arrow {
    color: #00E5FF;
    font-size: 34px;
    -unity-font-style: bold;
    opacity: 0;
    translate: -6px 0;
    transition-property: opacity, translate;
    transition-duration: 160ms;
}

.mbtn:hover {
    background-color: rgba(0, 229, 255, 0.12);
    border-color: #00E5FF;
    translate: -4px 0;
}
.mbtn:hover .mbtn__dot   { background-color: #00E5FF; scale: 1.4 1.4; }
.mbtn:hover .mbtn__label { color: #FFFFFF; translate: 2px 0; }
.mbtn:hover .mbtn__arrow { opacity: 1; translate: 0 0; }

.mbtn:active { background-color: rgba(0, 229, 255, 0.22); }

.mbtn:disabled {
    opacity: 0.35;
    border-color: rgba(74, 101, 119, 0.4);
}
.mbtn:disabled .mbtn__dot { background-color: #4A6577; }

.mbtn--danger .mbtn__dot   { background-color: rgba(255, 78, 91, 0.5); }
.mbtn--danger .mbtn__arrow { color: #FF4E5B; }
.mbtn--danger:hover {
    background-color: rgba(255, 78, 91, 0.12);
    border-color: #FF4E5B;
}
.mbtn--danger:hover .mbtn__dot { background-color: #FF4E5B; }

/* ---------- FOOTER STATUS ---------- */

.panel-footer {
    flex-direction: row;
    align-items: center;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: rgba(0, 229, 255, 0.18);
}

.status-dot {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: #67FFE9;
    margin-right: 12px;
}

.status-text {
    color: rgba(103, 255, 233, 0.85);
    font-size: 16px;
    letter-spacing: 5px;
    -unity-font-style: bold;
}

/* ============================================================
   LEFT — CONTROLS PANEL
   ============================================================ */

.controls {
    /*  sirine ekrana, bez max-widtha. */
    width: 42%;
    min-width: 320px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 34px;
    padding-bottom: 34px;
    background-color: rgba(8, 14, 24, 0.78);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.30);
    border-radius: 2px;
    flex-direction: column;
    flex-shrink: 0;            /* nikad ne stezi - radije siri */
}

.ctrl-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 8px;
}

.ctrl-label {
    color: rgba(220, 238, 246, 0.85);
    font-size: 17px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    margin-left: 16px;
}

/* Key caps */
.key {
    min-width: 38px;
    height: 38px;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 5px;
    background-color: rgba(0, 229, 255, 0.08);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.55);
    border-radius: 2px;
    color: #DCEEF6;
    font-size: 17px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.key--wide  { min-width: 80px; }
.key--xwide { min-width: 108px; }

/* WASD: W centered on top of A S D */
.key-group {
    flex-direction: column;
    align-items: center;
    margin-right: 10px;
}
.key--center { margin-bottom: 3px; }
.key-stack { flex-direction: row; }

